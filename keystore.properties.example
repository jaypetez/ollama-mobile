# ---------------------------------------------------------------------------
# OllamaMobile release signing -- EXAMPLE
#
# Copy to `keystore.properties` at the repository root and edit, or let
# `scripts/gen-dev-keystore.ps1` generate both the keystore and this file for
# you. `keystore.properties`, `*.jks` and `*.keystore` are gitignored; this
# `.example` is the only one of the family that is tracked, which is why it
# must never contain a real value.
#
# Signing is OPT-IN. With no `keystore.properties` and no OLLAMA_KEYSTORE_*
# environment variables, `assembleRelease` and `bundleRelease` still succeed --
# app/build.gradle.kts falls back to the debug key and prints:
#
#   No keystore.properties and no OLLAMA_KEYSTORE_* env vars: signing the
#   release build with the DEBUG key. This artefact must not be published.
#
# That fallback exists so any contributor can exercise R8 locally. It is a
# development convenience, never a release path.
#
# Precedence, per key, in app/build.gradle.kts:
#   keystore.properties  ->  environment variable  ->  debug-key fallback
#
# Environment equivalents, which is what .github/workflows/release.yml exports:
#   storeFile      OLLAMA_KEYSTORE_PATH
#   storePassword  OLLAMA_KEYSTORE_PASSWORD
#   keyAlias       OLLAMA_KEY_ALIAS
#   keyPassword    OLLAMA_KEY_PASSWORD
#
# THE REAL RELEASE KEY LIVES IN GITHUB ACTIONS SECRETS AND NOWHERE ELSE. Do not
# put it on a laptop. See docs/release-process.md.
# ---------------------------------------------------------------------------

# Path to the keystore.
#
# java.util.Properties treats `\` as an escape, so a Windows path must use
# forward slashes (java.io.File accepts them on Windows) or be doubled. Use an
# ABSOLUTE path: app/build.gradle.kts resolves this with the :app module's
# `file(...)`, so a relative path is interpreted against `app/`, not the root.
storeFile=C:/git/ollama-mobile/dev-debug.jks

# Store password. Stored in plaintext, which is exactly why a local key must be
# worthless.
storePassword=android

# Alias of the key inside the keystore.
keyAlias=ollamamobile-dev

# Key password. keytool creates PKCS12 keystores, in which the key password is
# required to equal the store password.
keyPassword=android
