<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. The same exclusions must appear under BOTH
  <cloud-backup> and <device-transfer>: they are evaluated independently, and
  omitting one silently ships multi-gigabyte models through that path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="downloads" />
        <exclude domain="file" path="rag-vectors" />
        <exclude domain="file" path="logs" />
        <exclude domain="file" path="crashes" />
        <exclude domain="external" path="." />
        <exclude domain="sharedpref" path="secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="downloads" />
        <exclude domain="file" path="rag-vectors" />
        <exclude domain="file" path="logs" />
        <exclude domain="file" path="crashes" />
        <exclude domain="external" path="." />
        <exclude domain="sharedpref" path="secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
