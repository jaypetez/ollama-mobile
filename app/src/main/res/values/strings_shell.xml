    <!-- ==================== Settings ==================== -->
    <string name="settings_title">Settings</string>

    <string name="settings_network_title">Network</string>
    <string name="settings_network_description">
        Enforced for every request the app makes, against the resolved IP address rather than the
        hostname.
    </string>
    <string name="network_policy_open">Open</string>
    <string name="network_policy_open_description">
        Blocks nothing. Remote servers, model pulls and the model catalogue all work.
    </string>
    <string name="network_policy_lan_only">LAN only</string>
    <string name="network_policy_lan_only_description">
        Blocks every destination outside your local network, including Hugging Face downloads and
        any update check. Private ranges, Tailscale\'s 100.64.0.0/10 and loopback still work.
    </string>
    <string name="network_policy_offline">Offline</string>
    <string name="network_policy_offline_description">
        Blocks every outbound request, including servers on your own network. Blocked requests fail
        immediately instead of hanging.
    </string>

    <string name="settings_routing_title">Routing</string>
    <string name="settings_routing_description">Which engine a request is sent to when there is a choice.</string>
    <string name="settings_routing_no_local">
        On-device inference is not available in this build, so anything that requires a local model
        will fail. Every option below other than “Local only” behaves the same way today.
    </string>
    <string name="routing_policy_auto">Automatic</string>
    <string name="routing_policy_auto_description">Let the app choose. Today that always means a remote server.</string>
    <string name="routing_policy_prefer_remote">Prefer remote</string>
    <string name="routing_policy_prefer_remote_description">Use a server when one is reachable.</string>
    <string name="routing_policy_prefer_local">Prefer on-device</string>
    <string name="routing_policy_prefer_local_description">
        Would use an on-device model first. Falls back to a server, which is what happens every
        time in this build.
    </string>
    <string name="routing_policy_remote_only">Remote only</string>
    <string name="routing_policy_remote_only_description">Never run on this device.</string>
    <string name="routing_policy_local_only">On-device only</string>
    <string name="routing_policy_local_only_description">
        Never send anything to a server. In this build that means every request fails, because
        there is no on-device engine yet.
    </string>

