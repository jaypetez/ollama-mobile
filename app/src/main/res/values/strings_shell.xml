    <!-- ==================== Onboarding ==================== -->
    <string name="onboarding_welcome_title">Chat with your own Ollama</string>
    <string name="onboarding_welcome_body">
        Point this app at an Ollama server you run — on a desktop, a home server, or a Raspberry Pi
        — and chat with the models it has. There is no account and no cloud in between.
    </string>
    <string name="onboarding_local_unavailable">
        On-device inference is not available in this build. Every reply comes from a server you
        configure, so the app needs a reachable one to be useful.
    </string>
    <string name="onboarding_local_available">
        This build can also run models on the device itself.
    </string>
    <string name="onboarding_continue">Continue</string>

    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">
        Used to keep a long answer generating while the screen is off, and to report a failed model
        pull. Nothing is sent anywhere.
    </string>
    <string name="onboarding_notifications_allow">Allow notifications</string>
    <string name="onboarding_notifications_skip">Not now</string>
    <string name="onboarding_notifications_denied">
        Declined. Long generations may be interrupted when you leave the app; you can change this
        in Android settings at any time.
    </string>

    <string name="onboarding_choice_title">Where to start</string>
    <string name="onboarding_choice_body">
        Adding a server takes about thirty seconds and needs its address. You can also look around
        first and add one later.
    </string>
    <string name="onboarding_choice_add_server">Add a server</string>
    <string name="onboarding_choice_explore">Just look around</string>

