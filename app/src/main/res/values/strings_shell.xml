    <!-- ==================== Discovery ==================== -->
    <string name="discovery_title">Find servers</string>
    <string name="discovery_description">
        Probes every address on the network this phone is attached to, looking for Ollama on port
        11434.
    </string>
    <string name="discovery_vpn_caveat">
        Discovery cannot find servers reached over a VPN. A Tailscale or WireGuard peer sits behind
        the tunnel, on a different network from the one this phone is sweeping, so it is never
        probed and will never appear here. Add those by address, using “Add a server”.
    </string>
    <string name="discovery_start">Scan local network</string>
    <string name="discovery_stop">Stop scanning</string>
    <string name="discovery_scanning">Probing %1$d addresses…</string>
    <string name="discovery_none_found">
        Nothing answered. If your server is behind a VPN, add it by address instead.
    </string>
    <string name="discovery_found_version">Ollama %1$s</string>
    <string name="discovery_found_version_models">Ollama %1$s · %2$d models</string>
    <string name="discovery_add">Add</string>
    <string name="discovery_already_added">Already added</string>
    <string name="discovery_refused_subnet_too_wide">
        This network is too large to sweep — it would mean thousands of connection attempts. Add
        the server by address instead.
    </string>
    <string name="discovery_refused_no_network">No network. Turn on Wi-Fi and try again.</string>
    <string name="discovery_refused_no_ipv4">
        This phone has no IPv4 address on the current link, which usually means a VPN is the active
        network. Add the server by address instead.
    </string>

