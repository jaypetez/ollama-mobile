<?xml version="1.0" encoding="utf-8"?>
<!--
  On-device inference: the foreground service, the model manager and the
  discover/download screen.

  A note that applies to several strings below. The default build
  (`-Pollama.nativeSource=none`) has no inference engine at all, and every
  string that describes that state says so in those words. "No models" and "no
  engine" are different facts with different fixes, and telling a user of the
  default build to download a model would send them after four gigabytes that
  this build can never load.
-->
<resources>

    <!-- Foreground service -->
    <string name="inference_channel_name">Generating</string>
    <string name="inference_channel_description">Shown while an answer is being generated with the app in the background.</string>
    <string name="inference_notification_title">Generating a reply</string>
    <string name="inference_notification_local">%1$s, on this device</string>
    <string name="inference_notification_remote">%1$s</string>
    <string name="inference_notification_stop">Stop</string>
    <!--
      The PROPERTY_SPECIAL_USE_FGS_SUBTYPE value. Read by a Play reviewer, so it
      describes what the service does rather than naming a category.
    -->
    <string name="inference_fgs_subtype" translatable="false">Continues a language-model reply that the user started, while the app is in the background, and stops as soon as the reply finishes.</string>

    <!-- Model manager -->
