    <string name="models_no_engine_title">This build has no inference engine</string>
    <string name="models_no_engine_body">It was built with -Pollama.nativeSource=none, so llama.cpp is not in the APK and no model can be loaded here, whatever is on disk. Chat still works against a remote server.</string>

    <string name="models_empty_title">No models on this device</string>
    <string name="models_empty_description">Download one from the catalogue, search Hugging Face, or import a GGUF you already have.</string>
    <string name="models_empty_description_no_engine">Nothing is downloaded — but this build could not run one anyway, because it was built without an inference engine.</string>

    <string name="models_delete_title">Delete this model?</string>
