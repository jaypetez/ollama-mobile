<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Network. ACCESS_LOCAL_NETWORK is declared for forward compatibility with
      the runtime local-network permission; on older platforms it is inert.
      Discovery and the embedded server both need local subnet reachability.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Notifications for the inference, server and download services. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep generating while the screen is off, for the generation window only. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      arm64-v8a is the shipping target. Debug builds also carry x86_64 so
      instrumentation tests can run on an emulator; that never reaches release.
    -->
    <uses-feature
        android:name="android.hardware.ram.low"
        android:required="false" />

    <application
        android:name=".OllamaMobileApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OllamaMobile"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OllamaMobile.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps a generation alive while the UI is backgrounded, and nothing
          else. Started only when a turn is in flight and the app leaves the
          screen; it stops itself the moment the turn ends. See
          InferenceForegroundService.

          `specialUse` because none of the defined types describes "run a
          language model the user asked for": `dataSync` is the nearest and is
          both inaccurate and capped at six hours a day on Android 15. The
          subtype property below is the plain-words justification a Play
          reviewer reads, and it must stay in step with what the service
          actually does.
        -->
        <service
            android:name=".service.InferenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/inference_fgs_subtype" />
        </service>

        <!--
          WorkManager is initialised on demand by OllamaMobileApplication, which
          implements Configuration.Provider so that Hilt's worker factory can
          construct the @HiltWorker download worker. On-demand initialisation
          and the default androidx.startup initialiser are mutually exclusive,
          so the latter is removed here. Removing the whole InitializationProvider
          would break any other library that uses androidx.startup, hence the
          surgical tools:node="remove" on just the one meta-data entry.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Profileable so :benchmark can capture traces on a release build. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
