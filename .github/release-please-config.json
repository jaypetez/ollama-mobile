{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "signoff": "Jayson Petersen <jayson.petersen@gmail.com>",
  "pull-request-header": "Automated release PR. Merging it bumps version.txt, rewrites CHANGELOG.md and pushes the vX.Y.Z tag that triggers the release build.",
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "security", "section": "Security" },
    { "type": "perf", "section": "Changed" },
    { "type": "refactor", "section": "Changed" },
    { "type": "revert", "section": "Changed" },
    { "type": "deps", "section": "Changed" },
    { "type": "deprecate", "section": "Deprecated" },
    { "type": "remove", "section": "Removed" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "ollama-mobile",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
